{{> header title="Profile"}}
<main class="max-w-2xl mx-auto mt-10 p-8 bg-gray-50 dark:bg-gray-800 shadow-md transition-colors">
  <div class="space-y-4">
    <h2 class="text-2xl font-bold text-gray-900 dark:text-white">Welcome, {{user.username}}!</h2>
    <p class="text-gray-700 dark:text-white"><strong>Email:</strong> {{user.email}}</p>
    <p class="text-gray-700 dark:text-white"><strong>Bio:</strong> {{user.bio}}</p>
    
    <button onclick="window.location.href='/logout'" 
            class="mt-6 px-6 py-2 border-2 border-deep-red-600 text-deep-red-600 dark:text-deep-red-400 hover:bg-deep-red-600 hover:text-white transition-all">
      Logout
    </button>
  </div>
</main>
{{> footer}}